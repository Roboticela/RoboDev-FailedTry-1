<Robo>
  <Heading level="1" align="center">Robo Grid Engine</Heading>
  <Paragraph align="center">
    Native C++ 2D Grid layout engine with WebAssembly live rasterization, track fraction sizing (fr), auto-flow, column &amp; row spanning, alignments, and interactive controls.
  </Paragraph>

  <H2>1. Equal Multi-Column Grid (columns="3")</H2>
  <Paragraph>3 equal fractional columns with consistent 14px gap:</Paragraph>
  <Grid columns="3" gap="14" padding="16" background="#FFFFFF" cornerRadius="14" borderColor="#E5E5EA" borderWidth="1">
    <Button variant="filled">Analytics</Button>
    <Button variant="tinted">Cloud Storage</Button>
    <Button variant="gray">Security</Button>
    <Button variant="tinted">Databases</Button>
    <Button variant="filled">Networking</Button>
    <Button variant="plain">Settings</Button>
  </Grid>

  <H2>2. Proportional Tracks (columns="1fr 2fr 1fr")</H2>
  <Paragraph>Middle column is twice as wide as the outer columns, automatically distributing available width:</Paragraph>
  <Grid columns="1fr 2fr 1fr" gap="12" padding="16" background="#F2F2F7" cornerRadius="14">
    <Button variant="gray">Sidebar</Button>
    <Input variant="bordered" placeholder="Search main workspace records...">Robo Grid Architecture</Input>
    <Button variant="filled">Search</Button>
  </Grid>

  <H2>3. Column Spanning (colSpan="2" &amp; colSpan="3")</H2>
  <Paragraph>Hero cards and banner spans spanning multiple columns in a 3-column grid:</Paragraph>
  <Grid columns="3" gap="14" padding="16" background="#FFFFFF" cornerRadius="16" borderColor="#E5E5EA" borderWidth="1">
    <Flexbox colSpan="3" direction="row" justify="space-between" align="center" padding="14" background="#1C1C1E" cornerRadius="12">
      <H3 color="#FFFFFF">Project Overview Dashboard</H3>
      <Button variant="filled" background="#30D158" color="#000000">Status: Active</Button>
    </Flexbox>

    <Button colSpan="2" variant="filled" background="#007AFF" color="#FFFFFF">Main Feature Block (colSpan="2")</Button>
    <Button variant="gray">Action Panel</Button>

    <Button variant="tinted">Metric A: 99.9%</Button>
    <Button variant="tinted">Metric B: 12ms</Button>
    <Button variant="tinted">Metric C: 4.8 GB</Button>
  </Grid>

  <H2>4. Row Spanning (Sidebar + Multi-Row Layout)</H2>
  <Paragraph>Left sidebar spans 2 rows while right content rows stack cleanly:</Paragraph>
  <Grid columns="180 1fr" gap="14" padding="16" background="#F2F2F7" cornerRadius="16">
    <Flexbox rowSpan="2" direction="column" gap="10" padding="14" background="#FFFFFF" cornerRadius="12" borderColor="#E5E5EA" borderWidth="1">
      <H4>Navigation</H4>
      <Button variant="filled">Overview</Button>
      <Button variant="plain">Deployments</Button>
      <Button variant="plain">Team Access</Button>
      <Button variant="plain">Billing</Button>
    </Flexbox>

    <Flexbox direction="row" justify="space-between" align="center" padding="12" background="#FFFFFF" cornerRadius="12" borderColor="#E5E5EA" borderWidth="1">
      <Paragraph><Span fontWeight="semibold">Server Cluster US-East</Span> (Healthy)</Paragraph>
      <Button variant="tinted">Restart</Button>
    </Flexbox>

    <Flexbox direction="row" align="center" gap="12" padding="12" background="#FFFFFF" cornerRadius="12" borderColor="#E5E5EA" borderWidth="1">
      <Input flex="1" variant="bordered" placeholder="Quick command or script...">robo deploy --prod</Input>
      <Button variant="filled">Execute</Button>
    </Flexbox>
  </Grid>

  <H2>5. Responsive Form Grid (Labels &amp; Inputs)</H2>
  <Paragraph>2-column structured form with full-width action buttons:</Paragraph>
  <Grid columns="1fr 1fr" gap="14" padding="18" background="#FFFFFF" cornerRadius="16" borderColor="#E5E5EA" borderWidth="1">
    <Input variant="bordered" placeholder="First Name">Ada</Input>
    <Input variant="bordered" placeholder="Last Name">Lovelace</Input>
    <Input colSpan="2" variant="bordered" placeholder="Email Address">ada.lovelace@computing.org</Input>
    <Input colSpan="2" variant="bordered" placeholder="Organization">Analytical Engine Labs</Input>
    <Button variant="gray">Cancel</Button>
    <Button variant="filled">Create Account</Button>
  </Grid>

  <H2>6. Cell Alignment (justifyItems &amp; alignItems)</H2>
  <Paragraph>Centered cells with custom self-aligning controls:</Paragraph>
  <Grid columns="3" justifyItems="center" alignItems="center" gap="14" padding="18" background="#F2F2F7" cornerRadius="14">
    <Button variant="filled">Centered 1</Button>
    <Button variant="tinted">Centered 2</Button>
    <Button variant="gray">Centered 3</Button>
    <Button justifySelf="start" variant="plain">Left-Aligned</Button>
    <Button justifySelf="center" variant="filled">Middle-Aligned</Button>
    <Button justifySelf="end" variant="plain">Right-Aligned</Button>
  </Grid>
</Robo>
